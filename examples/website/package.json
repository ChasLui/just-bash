{
  "name": "website",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "generate": "node scripts/generate-terminal-content.mjs",
    "fetch-agent-data": "node scripts/fetch-agent-data.mjs",
    "dev": "pnpm generate && next dev",
    "build": "pnpm --filter just-bash build && pnpm generate && pnpm fetch-agent-data && next build",
    "start": "next start",
    "lint": "eslint"
  },
  "dependencies": {
    "@vercel/analytics": "^1.6.1",
    "ai": "^6.0.253",
    "bash-tool": "^1.3.18",
    "geist": "^1.7.2",
    "just-bash": "workspace:*",
    "next": "16.2.0-canary.26",
    "react": "19.2.3",
    "react-dom": "19.2.3"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4.3.3",
    "@types/node": "^20.19.43",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.4",
    "eslint": "^9.39.5",
    "eslint-config-next": "16.1.6",
    "fast-check": "^4.9.0",
    "tailwindcss": "^4.3.3",
    "typescript": "^5.9.3"
  }
}
